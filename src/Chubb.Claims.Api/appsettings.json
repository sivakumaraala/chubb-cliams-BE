{
  "AllowedHosts": "localhost;127.0.0.1",
  "DemoIdentity": { "Enabled": false },
  "Database": { "InitializeOnStartup": true },
  "DemoMarkets": [
    { "Code": "M01", "Name": "Illustrative market 1", "Currencies": ["SGD", "AUD"] },
    { "Code": "M02", "Name": "Illustrative market 2", "Currencies": ["SGD", "AUD"] },
    { "Code": "M03", "Name": "Illustrative market 3", "Currencies": ["SGD", "AUD"] },
    { "Code": "M04", "Name": "Illustrative market 4", "Currencies": ["SGD", "AUD"] },
    { "Code": "M05", "Name": "Illustrative market 5", "Currencies": ["SGD", "AUD"] },
    { "Code": "M06", "Name": "Illustrative market 6", "Currencies": ["SGD", "AUD"] }
  ],
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "claims.decisions.v1",
    "GroupId": "claims.notifications.v1"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning", "System": "Warning" }
    },
    "Enrich": ["FromLogContext"],
    "Properties": { "Application": "Chubb.Claims.Api" },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/claims-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
